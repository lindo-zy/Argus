# 复制为 deploy/deploy.env（已被 gitignore，不会入库）按需修改；不存在的键用脚本内置默认值。
# 内置默认值：HOST=47.108.74.28 USER=root DIR=/opt/argus BRANCH=main REPO_URL=本地 origin。

#ARGUS_DEPLOY_HOST=47.108.74.28
#ARGUS_DEPLOY_USER=root
#ARGUS_DEPLOY_DIR=/opt/argus
#ARGUS_DEPLOY_BRANCH=main
#ARGUS_DEPLOY_REPO_URL=git@github.com:lindo-zy/Argus.git
# 本机 key 带口令会卡住，默认禁用公钥走密码登录；如已配好可用 key，清空此项即可。
#ARGUS_DEPLOY_SSH_OPTS=-o PubkeyAuthentication=no

# 非交互自动化：执行前 export SSHPASS='服务器密码'（需本机安装 sshpass）。
# 密码不要写进任何文件。
